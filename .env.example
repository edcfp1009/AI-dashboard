# Copy to .env for local live fetching. In CI these come from GitHub repo secrets.
# Only needed for sources set to "live" in config/sources.json — mock mode needs none.

# --- Datadog (MCP server telemetry via Logs API) ---
# Create at: Datadog > Organization Settings > API Keys / Application Keys
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# --- Langfuse (Copilot + Accessorial Agent traces) ---
# Create at: Langfuse > Project Settings > API Keys
# Keys are region-scoped. This project is on the US region, which is the code's
# default — an EU host with US keys returns 401. LANGFUSE_BASE_URL also works.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Mixpanel (enablement roster + frontend UI events) ---
# Create at: Mixpanel > Organization Settings > Service Accounts
MIXPANEL_SA_USERNAME=
MIXPANEL_SA_SECRET=
MIXPANEL_PROJECT_ID=
